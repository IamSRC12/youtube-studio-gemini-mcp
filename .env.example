# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 OAuth2 Credentials
# Option A: Direct credentials
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
# Option B: Path to client_secret.json (e.g. ~/.youtube-mcp/client_secret.json)
YOUTUBE_MCP_CLIENT_SECRET=

# YouTube OAuth Refresh Token (generated via npm run auth-helper)
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# Ngrok Auth Token (Optional for basic tunnels, required for custom persistent domains)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Server Configuration
PORT=3000

# MCP Connection Mode: "sse" (built-in express server) or "stdio" (external github mcp binary)
MCP_MODE=sse

# External GitHub MCP command configuration (only used if MCP_MODE=stdio)
# Example Python GitHub MCP Server: python path/to/youtube_mcp.py
# Example Node GitHub MCP Server: npx -y @pauling-ai/youtube-mcp-server
EXTERNAL_MCP_COMMAND=npx
EXTERNAL_MCP_ARGS=-y,@pauling-ai/youtube-mcp-server
